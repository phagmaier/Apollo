    {"id":"f4","type":"parenthetical","text":"(‘quietly’)"},
    {"id":"f5","type":"dialogue","text":"I’m sure…\nWe’ll wait.","styles":[{"start":4,"end":8,"style":"bold"}]},
    {"id":"f6","type":"character","text":"THEO","dual":true},
    {"id":"f7","type":"dialogue","text":"“Then wait,” he says."},
