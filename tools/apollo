#!/usr/bin/env bash
set -euo pipefail
# Resolve user-created symlinks as well as paths containing spaces.
launcher=$(readlink -f -- "${BASH_SOURCE[0]}")
runtime=$(cd -- "$(dirname -- "$launcher")/../lib/apollo" && pwd -P)
if [[ -z ${QT_QPA_PLATFORM:-} && -n ${WAYLAND_DISPLAY:-} ]]; then
  export QT_QPA_PLATFORM=wayland
fi
exec "$runtime/apollo_editor" "$@"
